{
  "name": "ionoscope-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src *.json *.mjs *.ts",
    "format:check": "prettier --check src *.json *.mjs *.ts",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "plotly.js-basic-dist-min": "4.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/plotly.js": "3.0.15",
    "angular-eslint": "22.6.0",
    "eslint": "9.39.5",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
